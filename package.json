{
  "name": "shapez",
  "version": "1.0.0",
  "description": "Shape drawing game for kids",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "deploy": "rm -rf dist && npm run build && workbox injectManifest workbox-config.cjs && echo shapez.euans.space > dist/CNAME && gh-pages -d dist"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/euangoddard/shapez.git"
  },
  "author": "Euan Goddard",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/euangoddard/shapez/issues"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "gh-pages": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "workbox-cli": "^7.4.1"
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 ios_saf versions"
  ]
}
